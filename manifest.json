{
  "manifest_version": 3,
  "name": "AeroRecord - Tab & Screen Recorder",
  "version": "1.0.0",
  "description": "High-performance tab screen recorder with 720p/1080p, mobile-mode cropping, no time limits, and MP4/WebM export.",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "permissions": [
    "tabCapture",
    "activeTab",
    "offscreen",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "src/icons/icon32.png",
    "default_title": "AeroRecord"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
